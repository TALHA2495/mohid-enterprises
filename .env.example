# Copy to .env.local and fill in real values. Never commit .env.local.

# WhatsApp Business Click-to-Chat number (international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=92XXXXXXXXXX

# Admin dashboard password (proxy.ts + /api/admin/login)
ADMIN_PASSWORD=change-me

# Supabase — Dashboard → Settings → API keys.
# New projects issue "publishable"/"secret" keys; older ones issue anon/service_role JWTs.
# Both styles work. Leave a value EMPTY until you have the real one: a leftover
# placeholder is treated as "configured" and then fails at runtime with a 401.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ImageKit — Dashboard → Developer options.
# Products (and hero cards) are served from the ImageKit CDN; product uploads in
# the admin area are signed with the private key (server-side only).
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR-ID
