# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
build.log
smoke-*.log

# Build artifacts
*.tsbuildinfo
.vercel

# Agent scaffolding (tool state - never commit)
# NOTE: .clinerules/ is deliberately NOT ignored - it holds the always-on
# git-github-automation trigger and must survive a fresh clone.
.agents/
.aider-desk/
.claude/
skills-lock.json

# Audit artifacts: one-off probes/shots/logs stay local; the reusable
# harnesses (e2e-full.mjs, admin-*.mjs, factory-verify.mjs) remain tracked.
.audit/probe*.mjs
.audit/sweep*.txt
.audit/*.log
.audit/dev.log
.audit/shots/

